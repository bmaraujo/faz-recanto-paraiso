{
  "name": "@recanto/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lambdas (TypeScript) atras do CloudFront em /api/*",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integracao": "node scripts/test-integracao.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@aws-sdk/s3-presigned-post": "^3.1153.0",
    "@recanto/shared": "*",
    "aws-jwt-verify": "^5.2.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/jsonwebtoken": "^9.0.10",
    "esbuild": "^0.25.0",
    "jsonwebtoken": "^9.0.3"
  }
}
